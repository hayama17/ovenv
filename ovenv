#!/usr/bin/env bash
# ovenv: stage a command's filesystem side effects in OverlayFS, then review, apply or discard them.
set -euo pipefail
shopt -s inherit_errexit

VERSION=0.2.0
SELF=$(realpath "$0")

ROOT_DEFAULT='/usr
/opt
/etc
/var
/root'
# shellcheck disable=SC2088  # expanded in paths()
USER_DEFAULT='~/.local
~/.cargo
~/.npm
~/.cache
~/.config'

die() { echo "ovenv: $*" >&2; exit 1; }

find_dir() {
  local d=$PWD
  while [[ $d != / ]]; do
    [[ -d $d/.ovenv ]] && { echo "$d/.ovenv"; return; }
    d=$(dirname "$d")
  done
  echo "$PWD/.ovenv"
}

D=$(realpath -m "${OVENV_DIR:-$(find_dir)}")
PROJECT=$(dirname "$D")

# root and user mode store overlay metadata in different xattr namespaces, so an env sticks to one.
if [[ -f $D/mode ]]; then MODE=$(<"$D/mode"); elif [[ $EUID -eq 0 ]]; then MODE=root; else MODE=user; fi
if [[ ${1:-} != __enter ]]; then  # inside the user namespace EUID is 0
  [[ $MODE == root && $EUID -ne 0 ]] && die "$D was created as root; use sudo"
  [[ $MODE == user && $EUID -eq 0 ]] && die "$D was created without root; run without sudo"
fi
if [[ $MODE == root ]]; then XATTR=trusted.overlay.opaque; else XATTR=user.overlay.opaque; fi

# Prints "overlay<TAB>path" or "rw<TAB>path".
paths() {
  local src a b
  if [[ -f $D/paths ]]; then src=$(<"$D/paths"); elif [[ $MODE == root ]]; then src=$ROOT_DEFAULT; else src=$USER_DEFAULT; fi
  while read -r a b; do
    [[ -z $a || $a == \#* ]] && continue
    if [[ $a == rw ]]; then a=$b; printf rw; else printf overlay; fi
    a=${a/#\~/$HOME}
    printf '\t%s\n' "$(realpath -m "$a")"
  done <<<"$src"
}

overlays() { paths | sed -n 's/^overlay\t//p'; }

# One run, shell, apply or discard per .ovenv; held until that command has fully finished.
lock() {
  mkdir -p "$D"
  touch "$D/lock"
  exec 9<"$D/lock"  # read-only: an fd open for writing makes the ro remount fail with EBUSY
  flock -xn 9 || die "$D is in use by another ovenv run, shell, apply or discard"
}

enter() {
  local p xopt=''
  local -a ov=() rw=("$PROJECT" /tmp)
  [[ $MODE == user ]] && xopt=,userxattr
  while IFS=$'\t' read -r kind p; do
    if [[ $kind == rw ]]; then rw+=("$p"); continue; fi
    [[ $D == "$p" || $D == "$p"/* ]] && die "$D is inside overlay path $p"
    if [[ $MODE == user && -e $p && ! -O $p ]]; then echo "ovenv: skipping $p (needs root)" >&2; continue; fi
    ov+=("$p")
  done < <(paths)

  # Overlay needs a writable upper at mount time, so mount before making everything read-only.
  for p in "${ov[@]}"; do
    mkdir -p "$p" "$D/upper$p" "$D/work$p"
    mount -t overlay ovenv -o "lowerdir=$p,upperdir=$D/upper$p,workdir=$D/work$p$xopt" "$p"
  done
  # Anything not overlaid or passed through is read-only, so writes can't silently reach the host.
  mount -o remount,bind,ro=recursive /
  mount -o remount,bind,rw=recursive /proc
  mount -o remount,bind,rw=recursive /dev
  for p in "${ov[@]}"; do mount -o remount,bind,rw "$p"; done
  for p in "${rw[@]}"; do
    [[ -e $p ]] || continue
    mount --bind "$p" "$p"
    mount -o remount,bind,rw "$p"
  done

  # Re-resolve cwd, otherwise it still points below the new mounts.
  cd "$PWD" 2>/dev/null || cd /
  export OVENV=$D
  if [[ $MODE == user ]]; then
    exec unshare -U --map-user="$OVENV_UID" --map-group="$OVENV_GID" "$@"
  fi
  exec "$@"
}

run() {
  need_getfattr
  lock
  [[ -f $D/mode ]] || echo "$MODE" >"$D/mode"
  local rc=0
  trap : INT TERM  # a handler, not an ignore, so the command still gets the signal
  if [[ $MODE == root ]]; then
    unshare -m "$SELF" __enter "$@" || rc=$?
  else
    OVENV_UID=$(id -u) OVENV_GID=$(id -g) unshare -Urm "$SELF" __enter "$@" || rc=$?
  fi
  record_base
  exit "$rc"
}

need_getfattr() { command -v getfattr >/dev/null || die "getfattr not found (install the attr package)"; }
is_opaque() { [[ $(getfattr --absolute-names --only-values -n "$XATTR" "$1" 2>/dev/null) == y ]]; }
is_whiteout() { [[ -c $1 && ! -L $1 && $(stat -c %t%T "$1") == 00 ]]; }
is_dir() { [[ -d $1 && ! -L $1 ]]; }
exists() { [[ -e $1 || -L $1 ]]; }
attrs() { stat -c %a:%u:%g "$1"; }
xattrs() {
  getfattr -h -d -m - -e hex --absolute-names "$1" 2>/dev/null |
    grep -Ev '^(#|$)|^(trusted|user)\.overlay\.|^security\.selinux=' | sort || true
}

# What the host has at $1, precise enough to notice any change apply could overwrite.
host_state() {
  local h=$1 up=$2
  if [[ -L $h ]]; then
    printf 'l %s' "$(readlink "$h")"
  elif [[ ! -e $h ]]; then
    printf -
  elif [[ -d $h ]]; then
    printf 'd %s' "$(attrs "$h")"
    # contents only matter when the staged entry deletes or replaces the whole directory
    if ! is_dir "$up" || is_opaque "$up"; then
      printf ' %s' "$(find "$h" -mindepth 1 -printf '%P %y %m %U %G %s %T@ %l\n' | sort | sha256sum | cut -c1-64)"
    fi
  elif [[ -f $h ]]; then
    printf 'f %s %s' "$(attrs "$h")" "$( (sha256sum <"$h" || echo unreadable) | cut -c1-64)"
  else
    printf 'o %s' "$(stat -c %F "$h")"
  fi
}

# Remember what the host looked like when each path was first staged; apply checks against it.
record_base() {
  local p u f
  local -A seen=()
  if [[ -f $D/base ]]; then
    while IFS=$'\t' read -r f _; do seen[$f]=1; done <"$D/base"
  fi
  while read -r p; do
    u=$D/upper$p
    [[ -d $u ]] || continue
    while IFS= read -r -d '' f; do
      [[ -n ${seen[$p/$f]:-} ]] && continue
      printf '%s\t%s\n' "$p/$f" "$(host_state "$p/$f" "$u/$f")"
    done < <(cd "$u" && find . -mindepth 1 -printf '%P\0') >>"$D/base"
  done < <(overlays)
}

# Prints "KIND<TAB>overlay path<TAB>relative path<TAB>note". diff, the conflict check and apply all use this.
changes() {
  local p u f up h hp gone skip
  while read -r p; do
    u=$D/upper$p
    [[ -d $u ]] || continue
    gone='' skip=''  # directories whose host contents are replaced / whose staged contents are skipped
    # ponytail: newlines and tabs in filenames are not handled
    while IFS= read -r -d '' f; do
      [[ -n $gone && $f != "$gone"/* ]] && gone=''
      [[ -n $skip && $f != "$skip"/* ]] && skip=''
      [[ -n $skip ]] && continue
      up=$u/$f h=$p/$f hp=''
      [[ -z $gone ]] && exists "$h" && hp=1

      if is_whiteout "$up"; then
        [[ -n $hp ]] && printf 'DELETE\t%s\t%s\t\n' "$p" "$f"
        continue
      fi
      if ! is_dir "$up" && [[ ! -f $up && ! -L $up ]]; then
        printf 'SKIP\t%s\t%s\tspecial file\n' "$p" "$f"
        continue
      fi
      if [[ $(xattrs "$up") != "$([[ -n $hp ]] && xattrs "$h")" ]]; then
        printf 'SKIP\t%s\t%s\txattrs\n' "$p" "$f"
        is_dir "$up" && skip=$f
        continue
      fi

      if is_dir "$up"; then
        if [[ -z $hp ]]; then
          printf 'ADD\t%s\t%s\t\n' "$p" "$f"
        elif ! is_dir "$h" || is_opaque "$up"; then
          printf 'REPLACE\t%s\t%s\t\n' "$p" "$f"
          gone=$f
        elif [[ $(attrs "$up") != "$(attrs "$h")" ]]; then
          printf 'ATTR\t%s\t%s\t\n' "$p" "$f"
        fi
      elif [[ -z $hp ]]; then
        printf 'ADD\t%s\t%s\t\n' "$p" "$f"
      elif is_dir "$h"; then
        printf 'REPLACE\t%s\t%s\t\n' "$p" "$f"
      elif [[ -L $up && -L $h ]]; then
        if [[ $(readlink "$up") != "$(readlink "$h")" ]]; then
          printf 'MODIFY\t%s\t%s\t\n' "$p" "$f"
        elif [[ $(stat -c %u:%g "$up") != "$(stat -c %u:%g "$h")" ]]; then
          printf 'SKIP\t%s\t%s\tsymlink owner\n' "$p" "$f"
        fi
      elif [[ -L $up || -L $h || ! -f $h ]] || ! cmp -s "$up" "$h"; then
        printf 'MODIFY\t%s\t%s\t\n' "$p" "$f"
      # copy-up also happens on touch, so a file with the same content and attrs is not a change
      elif [[ $(attrs "$up") != "$(attrs "$h")" ]]; then
        printf 'ATTR\t%s\t%s\t\n' "$p" "$f"
      fi
    done < <(cd "$u" && find . -mindepth 1 -printf '%P\0')
  done < <(overlays)
  return 0
}

describe() { if [[ -L $1 ]]; then echo "symlink -> $(readlink "$1")"; else stat -c %F "$1"; fi; }

show_diff() {
  local content=${1:-} t p f note up h out
  local -a lines=()
  need_getfattr
  out=$(changes) || die "cannot read staged changes"
  [[ -n $out ]] && mapfile -t lines <<<"$out"
  (( ${#lines[@]} )) || return 0
  for l in "${lines[@]}"; do
    IFS=$'\t' read -r t p f note <<<"$l"
    printf '%-8s%s/%s' "$t" "$p" "$f"
    if is_dir "$D/upper$p/$f" || { [[ $t == DELETE ]] && is_dir "$p/$f"; }; then printf /; fi
    [[ -n $note ]] && printf '  (%s, not applied)' "$note"
    echo
  done
  echo
  du -sh "$D/upper" | cut -f1 | sed 's/$/ staged/'
  [[ $content == --content ]] || return 0

  for l in "${lines[@]}"; do
    IFS=$'\t' read -r t p f note <<<"$l"
    [[ $t == MODIFY ]] || continue
    up=$D/upper$p/$f h=$p/$f
    echo
    if [[ -L $up || -L $h ]]; then
      printf -- '--- host:%s\n+++ staged:%s\n-%s\n+%s\n' "$h" "$h" "$(describe "$h")" "$(describe "$up")"
    else
      diff -u --label "host:$h" --label "staged:$h" -- "$h" "$up" || [[ $? -eq 1 ]] || die "cannot compare $h"
    fi
  done
}

own() { if [[ $MODE == root ]]; then chown -h "$(stat -c %u:%g "$1")" "$2"; fi; }

# Put a copy of regular file or symlink $1 at $2 with rename(2), so $2 is never missing or half-written.
put() {
  local up=$1 h=$2 tmp
  if [[ -L $up ]]; then
    tmp=$(mktemp -u "$(dirname "$h")/.ovenv.XXXXXXXX")
    ln -s -- "$(readlink "$up")" "$tmp" || die "cannot create a temp file next to $h"
  else
    tmp=$(mktemp "$(dirname "$h")/.ovenv.XXXXXXXX") || die "cannot create a temp file next to $h"
    if ! { cat -- "$up" >"$tmp" && own "$up" "$tmp" && chmod "$(stat -c %a "$up")" "$tmp"; }; then
      rm -f -- "$tmp"
      die "cannot prepare $h; left it unchanged"
    fi
  fi
  # The temp file sits in the same directory, so mv is a plain rename and never falls back to copying.
  mv -fT -- "$tmp" "$h" || { rm -f -- "$tmp"; die "cannot replace $h; left it unchanged"; }
}

discard_files() {
  chmod -R u+rwx "$D/work" 2>/dev/null || true  # overlay leaves a mode-000 dir that blocks rm
  rm -rf "$D/upper" "$D/work" "$D/base" "$D/mode"
}

discard() { lock; discard_files; }

apply() {
  local force=${1:-} t p f note h up i out
  need_getfattr
  lock
  local -a lines=() conflicts=() skipped=() dirmodes=()
  local -A base=() made=()
  out=$(changes) || die "cannot read staged changes"
  [[ -n $out ]] && mapfile -t lines <<<"$out"
  if [[ -f $D/base ]]; then
    while IFS=$'\t' read -r h note; do base[$h]=$note; done <"$D/base"
  fi

  for l in "${lines[@]}"; do
    IFS=$'\t' read -r t p f note <<<"$l"
    h=$p/$f up=$D/upper$p/$f
    if [[ $t == SKIP ]]; then skipped+=("$h ($note)"); continue; fi
    if [[ -z ${base[$h]+x} ]]; then
      conflicts+=("$h (no record of the host state)")
    elif [[ $(host_state "$h" "$up") != "${base[$h]}" ]]; then
      conflicts+=("$h")
    fi
    [[ $t == ADD || $t == REPLACE ]] && is_dir "$up" && made[$h]=1
    if [[ $t == ADD ]] && ! is_dir "$(dirname "$h")" && [[ -z ${made[$(dirname "$h")]:-} ]]; then
      conflicts+=("$(dirname "$h") (parent directory is gone)")
    fi
  done
  if (( ${#conflicts[@]} )) && [[ $force != --force ]]; then
    printf 'ovenv: changed on the host since it was staged:\n' >&2
    printf '  %s\n' "${conflicts[@]}" >&2
    die "review them, then rerun with --force"
  fi

  for l in "${lines[@]}"; do
    IFS=$'\t' read -r t p f note <<<"$l"
    h=$p/$f up=$D/upper$p/$f
    case $t in
      SKIP) ;;
      DELETE) rm -rf -- "$h" ;;
      ATTR)
        own "$up" "$h"
        if is_dir "$up"; then dirmodes+=("$(stat -c %a "$up") $h"); else chmod "$(stat -c %a "$up")" "$h"; fi
        ;;
      ADD|REPLACE|MODIFY)
        [[ $t == REPLACE ]] && rm -rf -- "$h"
        if is_dir "$up"; then
          mkdir -m 700 -- "$h"
          own "$up" "$h"
          dirmodes+=("$(stat -c %a "$up") $h")
        else
          put "$up" "$h"
        fi
        ;;
    esac
  done
  # Directory modes go last, deepest first, so a read-only directory doesn't block writes below it.
  for (( i=${#dirmodes[@]}-1; i>=0; i-- )); do chmod "${dirmodes[i]%% *}" "${dirmodes[i]#* }"; done

  (( ${#skipped[@]} )) && printf 'not applied: %s\n' "${skipped[@]}"
  echo "applied $(( ${#lines[@]} - ${#skipped[@]} )) change(s)"
  discard_files
}

init() {
  [[ -e $PWD/.ovenv ]] && die ".ovenv already exists"
  mkdir -p "$PWD/.ovenv"
  {
    echo "# One path per line. Writes under these paths are staged in OverlayFS."
    echo "# Prefix with 'rw ' to let writes go straight to the host."
    echo "# Everything else is read-only inside ovenv, except this project, /tmp, /dev and /proc."
    if [[ $EUID -eq 0 ]]; then echo "$ROOT_DEFAULT"; else echo "$USER_DEFAULT"; fi
  } >"$PWD/.ovenv/paths"
  echo "created $PWD/.ovenv (add it to .gitignore)"
}

usage() {
  cat <<EOF
usage: ovenv <command>

  init              create .ovenv/ in the current directory
  run <cmd>...      run a command with its writes staged
  shell             start \$SHELL with writes staged
  diff [--content]  show staged changes (--content adds diff -u for modified files)
  apply [--force]   write staged changes to the host
  discard           throw staged changes away

Run with sudo to stage writes to system paths (/usr, /etc, ...).
EOF
}

case ${1:-} in
  init)      init ;;
  run)       shift; [[ $# -gt 0 ]] || die "usage: ovenv run <cmd>..."; run "$@" ;;
  shell)     run "${SHELL:-/bin/sh}" ;;
  __enter)   shift; enter "$@" ;;
  diff)      shift; show_diff "$@" ;;
  apply)     shift; apply "$@" ;;
  discard)   discard ;;
  --version) echo "ovenv $VERSION" ;;
  -h|--help|help) usage ;;
  *)         usage >&2; exit 2 ;;
esac
